{
  "$schema": "https://opencode.ai/config.json",
  "model": "strata/qwen3.8-flash-next-gyro-gyro-s",
  "small_model": "strata/qwen3.8-flash-next-gyro-gyro-s",
  "provider": {
    "strata": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Strata PC-SALA (Gyro-S 128K)",
      "options": {
        "baseURL": "http://127.0.0.1:18081/v1",
        "apiKey": "strata-local"
      },
      "models": {
        "qwen3.8-flash-next-gyro-gyro-s": {
          "name": "Qwen3.8-Flash-Next Gyro-S (128K)",
          "tool_call": true,
          "limit": {
            "context": 131072,
            "input": 120000,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "memory-writer": {
        "type": "local",
        "command": [
          "python3",
          "/home/igor/ia-sh/pc-sala-agent/memory-writer/memory_writer_mcp.py"
        ],
        "environment": {
          "MEMORY_WRITER_ENDPOINT": "http://127.0.0.1:18081/v1/chat/completions",
          "MEMORY_WRITER_MODEL": "qwen3.8-flash-next-gyro-gyro-s",
          "MEMORY_WRITER_TEMPERATURE": "0.6",
          "MEMORY_DB": "/home/igor/ia-sh/pc-sala-agent/memory-writer/memory.db"
        }
      }
    }
  }
}
