[Unit]
Description=Bonsai 2 27B PQ2_0 GPU (porta 8080)
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=igor
Group=igor
WorkingDirectory=/home/igor
Environment=LD_LIBRARY_PATH=/home/igor/opt/prism-gpu-build/install/lib
ExecStart=/home/igor/opt/prism-gpu-build/install/bin/llama-server \
    -m /home/igor/models/bonsai-2-27b/Ternary-Bonsai-2-27B-PQ2_0.gguf \
    --host 127.0.0.1 \
    --port 8080 \
    -c 55000 \
    -t 8 \
    -ngl 99 \
    --no-kv-offload \
    -n 2048 \
    --parallel 1 \
    --no-jinja \
    --threads-http 4 \
    --api-key-file /home/igor/.config/pcsala-bonsai/api.key
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target