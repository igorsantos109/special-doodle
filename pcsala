#!/usr/bin/env bash
# Wrapper fino: a logica vive em src/pcsala_agent/cli.py (entry point do pyproject).
# Apos `pip install -e .` pode-se usar o comando `pcsala` direto, sem este script.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PY="$HERE/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3)"
PYTHONPATH="$HERE/src${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m pcsala_agent.cli "$@"
